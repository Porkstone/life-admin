{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "vercel-build": "convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd \"pnpm run build\"",
    "lint": "eslint . && tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && convex dev --once && vite build"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "@react-email/render": "^1.4.0",
    "convex": "^1.45.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "resend": "^6.25.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5"
  },
  "overrides": {
    "@auth/core": {
      "jose": "6.2.3"
    },
    "flatted": "3.4.2",
    "lightningcss": "1.32.0",
    "sucrase": "3.35.1"
  }
